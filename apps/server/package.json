{
  "name": "@appinst/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@appinst/shared": "workspace:*",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
