# Public https address of the server (serves the Mini App, API, install pages and Freekassa callbacks)
PUBLIC_URL=https://shop.example.com
PORT=3000
DATABASE_URL=postgres://appinst:appinst@localhost:5432/appinst

# Telegram bot from @BotFather
BOT_TOKEN=8985722795:AAHIE4VNK4M6TKfXkvlikYBhSPWj2muQKHI
BOT_USERNAME=my_shop_bot
# Short name of the Mini App created with /newapp in @BotFather (t.me/<bot>/<short name>)
MINIAPP_SHORT_NAME=app
# polling | webhook | off
BOT_MODE=polling
BOT_WEBHOOK_SECRET=
# Comma separated Telegram user ids with access to the admin tab
ADMIN_IDS=
SUPPORT_URL=https://t.me/my_shop_support

# Freekassa (cabinet → Настройки магазина)
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_1=
FREEKASSA_SECRET_2=
FREEKASSA_PAY_URL=https://pay.fk.money/
# Optional payment method id passed as `i` (e.g. SBP), leave empty to let the user choose
FREEKASSA_METHOD_ID=
FREEKASSA_CHECK_IP=true

# Random string, at least 16 chars: signs per-purchase install links
INSTALL_LINK_SECRET=
REFERRAL_PERCENT=10
REFERRAL_MIN_PAYOUT_RUB=500
